<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.TvBrowserPro" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg_root</item>
        <item name="android:colorBackground">@color/bg_root</item>
        <item name="colorPrimary">@color/accent_primary</item>
        <item name="colorPrimaryDark">@color/bg_root</item>
        <item name="colorAccent">@color/accent_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@style/TvWindowAnimation</item>
    </style>

    <style name="Theme.TvBrowserPro.Player" parent="Theme.TvBrowserPro">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="TvWindowAnimation" parent="android:Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@android:anim/fade_in</item>
        <item name="android:activityOpenExitAnimation">@android:anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@android:anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@android:anim/fade_out</item>
    </style>

    <!-- Tab bar card text -->
    <style name="TabCardText">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_size_medium</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center_vertical</item>
    </style>

</resources>
